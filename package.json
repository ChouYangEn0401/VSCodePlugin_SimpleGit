{
  "name": "isd-simple-git",
  "displayName": "ISD Simple Git",
  "description": "Simple right-click Git helper: add, restore, stage hunks, show log, commit",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:isd.git-tool"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "isd.git-tool",
        "title": "ISD: Git Tool"
      },
      {
        "command": "git-add.addFile",
        "title": "Git Add"
      },
      {
        "command": "git-add.unstage",
        "title": "Git Unstage (Restore staged)"
      },
      {
        "command": "git-add.stageSelection",
        "title": "Git: Stage Selection (if supported)"
      },
      {
        "command": "git-add.stageSelectedLines",
        "title": "Git: Stage Selected Lines"
      },
      {
        "command": "git-add.stageHunks",
        "title": "Git: Stage Hunks (patch-based)"
      },
      {
        "command": "git-add.showLog",
        "title": "Git: Show File Log"
      },
      {
        "command": "git-add.commit",
        "title": "Git: Commit (message)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "isd.git-tool",
          "group": "git"
        }
      ],
      "editor/context": [
        {
          "command": "isd.git-tool",
          "group": "git"
        }
      ]
    }
  }
}
